# Blender autosaves, backups, and local temp files
*.blend1
*.blend2
*.blend@
*.blend[0-9]
*.blend[0-9][0-9]
*.blend[0-9][0-9][0-9]
*.tmp
*.temp

# Blender simulation/cache output
blendcache_*/
cache/
caches/
*.vdb
waveletNoiseTile.bin

# Generated render outputs
renders/**/*.png
renders/**/*.jpg
renders/**/*.jpeg
renders/**/*.exr
renders/**/*.tif
renders/**/*.tiff
renders/**/*.mp4
renders/**/*.mov
renders/**/*.avi
renders/**/*.mkv
renders/**/*.blend
!renders/.gitkeep

# Large/local source archives
assets/**/*.zip
assets/**/*.7z
assets/**/*.rar
assets/**/*.usdz

# Track the curated project assets needed to regenerate the scene
!assets/hdri/
!assets/hdri/**
!assets/rocket/
!assets/rocket/**
!assets/eifel_tower/
!assets/eifel_tower/eifel_munarasy.glb
!assets/eifel_tower/SOURCE.md

# Python/editor/local OS files
__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
Thumbs.db
.idea/
.vscode/
